# General Config
ENVIRONMENT=development

# Postgres Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=solar_wind_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/solar_wind_db

# MongoDB Configuration
MONGO_USER=mongo
MONGO_PASSWORD=mongo
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB_NAME=solar_wind_mongo
MONGO_URL=mongodb://mongo:mongo@mongo:27017

# JWT Authentication Config
JWT_SECRET=supersecretjwtsecretkey
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
